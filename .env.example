# Local development only — copy to .env and fill in values. Never commit .env

LLM_API_KEY=
LLM_PROVIDER=openrouter
LLM_MODEL=openai/gpt-4o-mini
GITHUB_TOKEN=

# Supabase (set your project URL and service role key)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Run `codereview index-knowledge --repo owner/repo` to populate the unified index

# Optional JIRA / Confluence
# ATLASSIAN_EMAIL=
# ATLASSIAN_API_TOKEN=
# ATLASSIAN_DOMAIN=yourcompany.atlassian.net
